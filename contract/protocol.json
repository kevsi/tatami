{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatami.app/contract/protocol.json",
  "title": "Tatami engine protocol v0 (draft)",
  "description": "NDJSON sur stdio (une valeur JSON par ligne). stdout = protocole uniquement, logs sur stderr. Version du protocole : \"0.1\" (compatible = même MAJEUR). Voir contract/README.md.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "method": {
      "type": "string",
      "enum": [
        "hello",
        "listSources",
        "filterOptions",
        "latest",
        "search",
        "details",
        "chapters",
        "pages",
        "fetchImage",
        "fetchCover",
        "setCookies",
        "health",
        "shutdown",
        "detect",
        "ocr",
        "inpaint",
        "loadPack",
        "capabilities"
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "SOURCE_UNAVAILABLE",
        "CHALLENGE_REQUIRED",
        "AUTH_REQUIRED",
        "PARSE_ERROR",
        "RATE_LIMITED",
        "TIMEOUT",
        "CANCELLED",
        "INTERNAL",
        "MODEL_MISSING",
        "OUT_OF_MEMORY",
        "TILE_TOO_LARGE"
      ]
    },
    "request": {
      "type": "object",
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "type": "string", "description": "Identifiant unique (Rust). Les réponses le recopient." },
        "method": { "$ref": "#/$defs/method" },
        "params": { "type": "object" },
        "timeoutMs": { "type": "integer", "minimum": 1, "description": "Délai max côté Rust ; passé ce délai Rust ignore la réponse (le moteur finit quand même, sans état)." }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["id", "ok"],
      "properties": {
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "result": { "type": "object", "description": "Présent si ok = true. Forme par méthode : voir contract/README.md." },
        "error": {
          "type": "object",
          "description": "Présent si ok = false.",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/errorCode" },
            "message": { "type": "string" },
            "url": { "type": "string", "description": "Présent pour CHALLENGE_REQUIRED : page à ouvrir dans la fenêtre de résolution." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "manga": {
      "type": "object",
      "required": ["url", "title", "source"],
      "properties": {
        "url": { "type": "string", "description": "Clé stable du manga chez la source (relative ou absolue selon la source)." },
        "title": { "type": "string" },
        "source": { "type": "string", "description": "Nom d'entrée MangaParserSource, ex. MANGADEX." },
        "coverUrl": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "chapter": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "description": "Clé stable du chapitre." },
        "title": { "type": "string" },
        "number": { "type": "number" },
        "uploadDate": { "type": "integer", "description": "Epoch millis, si fourni par la source." }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["index", "url"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "description": "URL de la page (pas forcément l'image directe : passer par fetchImage)." },
        "previewUrl": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sourceInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Nom d'entrée MangaParserSource, ex. MANGADEX." },
        "title": { "type": "string" },
        "locale": { "type": "string", "description": "ex. \"en\", si exposée par la source." },
        "lang": { "type": "string", "description": "Langue déduite du nom (Server.kt: inferLang), ex. \"fr\", \"int\"." }
      },
      "additionalProperties": true
    },
    "filterOptions": {
      "type": "object",
      "description": "Forme de `result` pour `filterOptions`.",
      "required": ["tags", "sortOrders"],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "key"],
            "properties": {
              "title": { "type": "string" },
              "key": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "sortOrders": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "imagePayload": {
      "type": "object",
      "description": "Forme de `result` pour `fetchImage` et `fetchCover`.",
      "required": ["data", "contentType"],
      "properties": {
        "data": { "type": "string", "description": "Octets de l'image, base64 standard." },
        "contentType": {
          "type": "string",
          "description": "Type ANNONCÉ par le site. Rust ne s'y fie pas : il déduit le type des octets (image::detect) et refuse d'écrire quoi que ce soit qui ne soit pas une image."
        }
      },
      "additionalProperties": true
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "capabilitiesResult": {
      "type": "object",
      "description": "Forme de `result` pour `capabilities` (sidecar vision). `inpaintDisponible` est `false` tant que le modèle d'effacement n'est pas dans le pack : l'application peut alors l'afficher au lieu d'appeler une méthode qui échouera.",
      "required": ["packId", "version", "methods", "inpaintDisponible"],
      "properties": {
        "packId": { "type": "string" },
        "version": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string", "enum": ["detect", "ocr", "inpaint"] }
        },
        "inpaintDisponible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "detectResult": {
      "type": "object",
      "description": "Forme de `result` pour `detect`. Une détection porte sa boîte, sa classe et son score. La classe est la classification de T2.3 (0 bubble, 1 text_bubble, 2 text_free) : elle est mesurée par le modèle, donc la jeter ici obligerait l'application à deviner un `type_bloc` que le schéma de traduction exige.",
      "required": ["detections"],
      "properties": {
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bbox", "classe", "score"],
            "properties": {
              "bbox": { "$ref": "#/$defs/bbox" },
              "classe": { "type": "integer", "minimum": 0, "maximum": 2 },
              "score": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ocrResult": {
      "type": "object",
      "description": "Forme de `result` pour `ocr`.",
      "required": ["lines"],
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "bbox"],
            "properties": {
              "text": { "type": "string" },
              "bbox": { "$ref": "#/$defs/bbox" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inpaintResult": {
      "type": "object",
      "description": "Forme de `result` pour `inpaint`.",
      "required": ["data", "contentType"],
      "properties": {
        "data": { "type": "string", "description": "Image nettoyée, base64 standard." },
        "contentType": { "type": "string", "description": "Type MIME de l'image résultante (ex. image/png)." }
      },
      "additionalProperties": false
    },
    "packManifest": {
      "type": "object",
      "required": ["packId", "version", "models", "sha256"],
      "properties": {
        "packId": { "type": "string" },
        "version": { "type": "string" },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "sha256": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "sha256": { "type": "string", "description": "Hash du manifeste, pour vérification de cohérence." }
      },
      "additionalProperties": false
    },
    "loadPackResult": {
      "type": "object",
      "description": "Forme de `result` pour `loadPack`.",
      "required": ["packId", "version"],
      "properties": {
        "packId": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "healthResult": {
      "description": "Forme de `result` pour `health`. Cette méthode a **deux formes réelles**, et une seule était décrite jusqu'au 2026-10-07 : `health` global (`ok` + version du moteur ou du pack vision) et `health` par source (`source` + `reachable`, sans `ok`). La seconde était invisible parce qu'aucun `$defs` de résultat n'était appliqué par la validation — le trou que le contre-exemple « score de détection au-dessus du maximum » a fait apparaître. Les deux branches sont exclusives : chacune interdit les champs de l'autre.",
      "oneOf": [
        {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "engineVersion": { "type": "string" },
            "packId": { "type": "string" },
            "version": { "type": "string" },
            "models": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source", "reachable"],
          "properties": {
            "source": { "type": "string" },
            "reachable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}

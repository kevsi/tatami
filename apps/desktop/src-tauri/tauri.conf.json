{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tatami",
  "version": "0.1.0",
  "identifier": "app.tatami.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Tatami",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://tatami.localhost asset: http://asset.localhost; style-src 'unsafe-inline' 'self'; connect-src 'self' ipc: http://ipc.localhost tauri: http://tauri.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "resources": {
      "../../../engine/dist/tatami-engine": "engine/tatami-engine"
    }
  }
}

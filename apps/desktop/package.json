{
  "name": "tatami-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').existsSync('../../engine/dist/tatami-engine/runtime/bin/java.exe')||require('child_process').execSync('powershell -File ../../scripts/build-engine.ps1',{stdio:'inherit'})\"",
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').existsSync('../../engine/dist/tatami-engine/runtime/bin/java.exe')||require('child_process').execSync('powershell -File ../../scripts/build-engine.ps1',{stdio:'inherit'})\"",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "next": "16.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.7.0"
  }
}

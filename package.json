{
  "name": "tatami",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop manga reader (Windows first) with feature parity with Kotatsu-Redo mobile app",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm -C apps/desktop dev",
    "tauri": "pnpm -C apps/desktop tauri",
    "typecheck": "pnpm -C apps/desktop typecheck",
    "lint": "pnpm -C apps/desktop lint",
    "i18n:check": "pnpm -C apps/desktop i18n:check",
    "build": "pnpm -C apps/desktop build",
    "engine": "powershell -ExecutionPolicy Bypass -File scripts/build-engine.ps1"
  }
}
